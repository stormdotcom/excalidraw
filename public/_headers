/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: origin
  X-Frame-Options: SAMEORIGIN

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/service-worker.js
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
